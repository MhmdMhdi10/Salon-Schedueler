# Salon Booking System — backend environment variables
#
# This file documents every environment variable the backend reads (see
# backend/src/config.ts). Copy it to `.env` and fill in real values.
#
# In development, missing secrets fall back to safe documented defaults so the
# server still boots. In production (NODE_ENV=production) the server FAILS FAST if
# any variable marked "[required in production]" is missing.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma. [required in production]
DATABASE_URL="postgresql://user:password@localhost:5432/salon_dev?schema=public"

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
# Secret used to sign/verify JWT access tokens.  [required in production]
JWT_ACCESS_SECRET="dev-access-secret"
# Secret used to sign/verify JWT refresh tokens. [required in production]
JWT_REFRESH_SECRET="dev-refresh-secret"

# ── Payment ─────────────────────────────────────────────────────────────────
# Which payment gateway adapter to use: "zarinpal", "idpay", or "zibal". [optional, default: zarinpal]
PAYMENT_GATEWAY="zarinpal"
# Zarinpal merchant id. [optional — used only when PAYMENT_GATEWAY=zarinpal]
ZARINPAL_MERCHANT_ID=""
# IDPay API key. [optional — used only when PAYMENT_GATEWAY=idpay]
IDPAY_API_KEY=""
# Zibal merchant/API key. [optional — used only when PAYMENT_GATEWAY=zibal]
ZIBAL_MERCHANT=""
# Base URL the payment gateway calls back to after payment. [required in production]
PAYMENT_CALLBACK_BASE_URL="http://localhost:3000"

# ── SMS providers ─────────────────────────────────────────────────────────────
# Provider credentials are optional: when a provider's API key is absent the
# composition root selects a dev/log SMS adapter so the system still runs locally.
# Kavenegar is preferred when its key is present; otherwise SMS.ir is used.
#
# Kavenegar
KAVENEGAR_API_KEY=""
# Kavenegar API base URL override. [optional — sensible default otherwise]
KAVENEGAR_BASE_URL=""
# Kavenegar sender line. [optional — account default used when absent]
KAVENEGAR_SENDER=""
#
# SMS.ir
SMSIR_API_KEY=""
# SMS.ir API base URL override. [optional]
SMSIR_BASE_URL=""
# SMS.ir sender line number. [optional]
SMSIR_LINE_NUMBER=""

# Melli Payamak shared-template endpoint for OTP and fixed notifications. The
# token stays in a secret env file. AuthService sends OTP as args[0]; fixed
# notification bodyIds are defined in the notification template catalog.
MELIPAYAMAK_URL="https://console.melipayamak.com/api/send/shared/<your-token>"
MELIPAYAMAK_BODY_ID="523232"
# Legacy generated-code endpoint (optional fallback).
# MELIPAYAMAK_OTP_URL="https://console.melipayamak.com/api/send/otp/<your-token>"

# ── Push providers ────────────────────────────────────────────────────────────
# Optional: when a provider's API key is absent the composition root selects a
# dev/log push adapter. Pushe is preferred when its key is present; otherwise Najva.
#
# Pushe
PUSHE_API_KEY=""
# Pushe API base URL override. [optional]
PUSHE_BASE_URL=""
# Pushe application id. [optional]
PUSHE_APP_ID=""
#
# Najva
NAJVA_API_KEY=""
# Najva API base URL override. [optional]
NAJVA_BASE_URL=""

# ── Messaging bots (Telegram / Bale) ──────────────────────────────────────────
# Bot tokens are optional: when a platform's token is absent that bot channel is
# disabled and the rest of the system keeps running without error.
#
# Telegram bot token (from BotFather). [optional — absence disables Telegram channel]
TELEGRAM_BOT_TOKEN=""
# Bale bot token. [optional — absence disables Bale channel]
BALE_BOT_TOKEN=""
# Shared secret guarding the public bot webhook routes
# (POST /api/bots/telegram/:secret and /api/bots/bale/:secret). [optional in dev]
BOT_WEBHOOK_SECRET=""

# ── Subscription plans ────────────────────────────────────────────────────────
# Plan prices are configurable at runtime (not hard-coded). Values are in IRR.
# When absent, the corresponding paid plan price is unset.
#
# Monthly plan price in IRR. [optional]
SUB_MONTHLY_RIAL=""
# Quarterly plan price in IRR. [optional]
SUB_QUARTERLY_RIAL=""
# Annual plan price in IRR. [optional]
SUB_ANNUAL_RIAL=""
# Free trial length in days. [optional, default: 14]
SUB_TRIAL_DAYS="14"

# ── Reliable SMS (RabbitMQ) ───────────────────────────────────────────────────
# When set, outbound SMS is published to a durable RabbitMQ queue (publisher
# confirms + persistent messages) and a separate worker (`npm run start:worker`)
# delivers it with manual ack, backoff retry, and dead-lettering. When absent,
# SMS is sent directly (synchronous, the prior behavior). [optional]
RABBITMQ_URL="amqp://salon:salon@localhost:5672"
# Max delivery attempts before a message is dead-lettered. [optional, default: 5]
SMS_QUEUE_MAX_ATTEMPTS="5"
# Backoff before a failed SMS is retried, in ms. [optional, default: 30000]
SMS_QUEUE_RETRY_DELAY_MS="30000"

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP port the server listens on. [optional, default: 3000]
PORT="3000"
# Node environment: "development" or "production". [optional, default: development]
NODE_ENV="development"

# Temporary explicit test-only flag: return generated OTP to web client for autofill.
DEV_OTP_AUTO_FILL="false"
