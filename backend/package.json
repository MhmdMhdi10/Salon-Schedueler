{
  "name": "@salon/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Express HTTP API and domain services for the Salon Booking System",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "e2e": "node scripts/run-cucumber.mjs",
    "e2e:cucumber": "node scripts/run-cucumber.mjs",
    "e2e:cucumber:typecheck": "tsc -p features/tsconfig.json --noEmit --tsBuildInfoFile /tmp/salon-backend-cucumber.tsbuildinfo",
    "e2e:cucumber:controllers": "node scripts/run-cucumber.mjs features/tests/controllers",
    "e2e:cucumber:structure": "node scripts/check-feature-structure.mjs",
    "e2e:cucumber:dto-coverage": "node scripts/check-dto-coverage.mjs",
    "e2e:cucumber:controller-coverage": "npm run e2e:cucumber:controllers && npm run e2e:cucumber:structure && node scripts/check-controller-coverage.mjs && node scripts/check-dto-coverage.mjs",
    "e2e:cucumber:coverage": "c8 --config ./c8-e2e.config.json node scripts/run-cucumber.mjs && npm run e2e:cucumber:structure && node scripts/check-controller-coverage.mjs && node scripts/check-dto-coverage.mjs",
    "start:cron": "node dist/notification-cron.js",
    "start:worker": "node dist/sms-worker.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:format": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@salon/shared": "*",
    "amqplib": "^0.10.4",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.3",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
