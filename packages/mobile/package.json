    "react-native": "0.81.5",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/metro-config": "~54.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "fast-check": "^4.8.0",
