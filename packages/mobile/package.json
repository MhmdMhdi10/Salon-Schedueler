{
  "name": "@salon/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "React Native mobile app for the Salon Booking System",
  "main": "index.ts",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.10",
    "@salon/shared": "*",
    "expo": "~57.0.13",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.7",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~6.0.3"
  }
}
