# Salon Booking System — Docker dev environment variables.
# Copy to `.env` (same directory as docker-compose.yml) and adjust as needed.
# Docker Compose loads `.env` automatically.

# Development host binding. Default ports are reachable only from this machine.
# Set to 0.0.0.0 only when a physical phone needs access over your local network.
DEV_BIND_HOST=127.0.0.1

# Host port for Postgres. Override if 5432 is already taken on your machine.
# The backend always reaches the DB over the compose network at postgres:5432.
POSTGRES_HOST_PORT=5432

# Your dev machine's LAN/Wi-Fi IP. For a physical phone using the `mobile`
# (Expo) profile, also set DEV_BIND_HOST=0.0.0.0 above so host ports are reachable.
# Find it with: `ip route get 1 | awk '{print $7; exit}'` (Linux) or `ipconfig getifaddr en0` (macOS).
# Leave as localhost only if you run an emulator on the host.
HOST_LAN_IP=192.168.1.199

# Reliable notification delivery (Docker defaults use these values).
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_PORT=15673
SMS_INBOX_HOST_PORT=8025

# Production/backend options. Keep DEV_OTP_AUTO_FILL disabled outside local dev.
DEV_USE_REAL_OTP=false
RABBITMQ_URL=amqp://salon:salon@rabbitmq:5672
REMINDER_INTERVAL_MS=60000
REMINDER_LEAD_TIME_MINUTES=60
TRUST_PROXY=false

# Optional Melli Payamak shared-template endpoint for OTP and fixed notifications.
# Keep account token private. Request shape: bodyId + to + args[0..n].
MELIPAYAMAK_URL=https://console.melipayamak.com/api/send/shared/<your-token>
# OTP template bodyId. Notification bodyIds are defined in backend source.
MELIPAYAMAK_BODY_ID=523232
# Optional plain-text endpoint used for staff-authored SMS and fallback alerts.
# MELIPAYAMAK_SIMPLE_URL=https://console.melipayamak.com/api/send/simple/<your-token>
# MELIPAYAMAK_SIMPLE_FROM=5000xxxx
# Legacy generated-code endpoint (use only when shared-template is unavailable).
# MELIPAYAMAK_OTP_URL=https://console.melipayamak.com/api/send/otp/<your-token>

# Set before publishing the web build so canonical/OG/sitemap URLs are real.
VITE_SITE_ORIGIN=https://your-domain.example

# Firebase web app configuration. These values are injected into the web build
# and are safe to expose as Firebase client configuration.
VITE_FIREBASE_API_KEY=AIzaSyD4u-uXrZS3elsZhjocpDEaLGwBQcyohpE
VITE_FIREBASE_AUTH_DOMAIN=ara-salon.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ara-salon
VITE_FIREBASE_STORAGE_BUCKET=ara-salon.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1074628365578
VITE_FIREBASE_APP_ID=1:1074628365578:web:d45fdbcebbfb6a2f78bef3
VITE_FIREBASE_MEASUREMENT_ID=G-F58VRXR2P0
# Firebase Cloud Messaging Web Push public certificate (VAPID) key.
VITE_FIREBASE_VAPID_KEY=

# Server-side Firebase Admin credentials. Prefer a mounted JSON service-account
# file via GOOGLE_APPLICATION_CREDENTIALS; never commit private keys.
FIREBASE_PROJECT_ID=ara-salon
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/ara-salon-firebase-admin.json
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
