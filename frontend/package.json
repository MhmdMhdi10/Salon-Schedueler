{
  "name": "@salon/web",
  "version": "0.0.1",
  "private": true,
  "description": "React PWA for the Salon Booking System",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/i18n/**",
    "src/main.tsx"
  ],
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "process-images": "node scripts/process-images.mjs",
    "pwa-assets": "node scripts/generate-pwa-assets.mjs",
    "prerender": "node scripts/prerender.mjs",
    "analyze-bundle": "node scripts/analyze-bundle.mjs",
    "build": "tsc -p tsconfig.json && npm run pwa-assets && npm run sitemap && vite build && npm run prerender && npm run analyze-bundle",
    "build:production": "tsc -p tsconfig.json && npm run pwa-assets && npm run sitemap && vite build && npm run prerender",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "tsc --noEmit -p tsconfig.json && npm test"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@salon/shared": "*",
    "animejs": "^4.5.0",
    "antd": "^5.29.3",
    "autoprefixer": "^10.5.1",
    "framer-motion": "^12.41.0",
    "i18next": "^26.3.1",
    "lucide-react": "^1.21.0",
    "postcss": "^8.5.26",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^4.2.4",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.2.0",
    "axe-core": "^4.12.1",
    "jsdom": "^24.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.4.0",
    "vitest-axe": "^0.1.0"
  }
}
