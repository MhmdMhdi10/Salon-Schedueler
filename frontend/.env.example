# Base URL of the Salon Booking System HTTP API the web client talks to.
#
# The client reads this at build time via `import.meta.env.VITE_API_BASE_URL`
# (see src/api/client.ts). When unset, it falls back to "/api", which the Vite
# dev server can proxy to a locally running backend.
#
# For staging/production builds, set this to the real API origin, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/api

# The single canonical public origin (apex OR www — pick one and 301 the other)
# used to build absolute canonicals, Open Graph URLs, and hreflang alternates in
# the <SeoHead> component (see src/components/seo/config.ts). No trailing slash.
# When unset it falls back to the documented placeholder used in the SEO
# steering examples.
#
#   VITE_PUBLIC_SITE_URL=https://example.ir
VITE_PUBLIC_SITE_URL=https://example.ir

# Firebase web app configuration for the Ara project. Firebase web config is
# public app metadata; keep environment-specific values here rather than in
# application source code.
VITE_FIREBASE_API_KEY=AIzaSyD4u-uXrZS3elsZhjocpDEaLGwBQcyohpE
VITE_FIREBASE_AUTH_DOMAIN=ara-salon.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ara-salon
VITE_FIREBASE_STORAGE_BUCKET=ara-salon.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1074628365578
VITE_FIREBASE_APP_ID=1:1074628365578:web:d45fdbcebbfb6a2f78bef3
VITE_FIREBASE_MEASUREMENT_ID=G-F58VRXR2P0
# Firebase Cloud Messaging Web Push public certificate (VAPID) key.
VITE_FIREBASE_VAPID_KEY=
