{
  "name": "salon-booking-system",
  "version": "0.0.1",
  "private": true,
  "description": "Salon Booking System - appointment scheduling platform for the Iranian market",
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared",
    "packages/mobile"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace @salon/backend",
    "dev:frontend": "npm run dev --workspace @salon/web",
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace @salon/shared",
    "build:backend": "npm run build --workspace @salon/backend",
    "build:frontend": "npm run build --workspace @salon/web",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run start --workspace @salon/backend",
    "start:frontend": "npm run preview --workspace @salon/web",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace @salon/backend",
    "test:frontend": "npm run test --workspace @salon/web",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report artifacts/playwright-report",
    "e2e:cucumber": "node scripts/run-cucumber.mjs",
    "e2e:cucumber:typecheck": "tsc -p features/tsconfig.json --noEmit",
    "e2e:cucumber:business": "node scripts/run-cucumber.mjs",
    "e2e:cucumber:backend": "npm --workspace @salon/backend run e2e:cucumber",
    "e2e:cucumber:typecheck:backend": "npm --workspace @salon/backend run e2e:cucumber:typecheck",
    "e2e:cucumber:controllers": "npm --workspace @salon/backend run e2e:cucumber:controllers",
    "e2e:cucumber:structure": "npm --workspace @salon/backend run e2e:cucumber:structure",
    "e2e:cucumber:dto-coverage": "npm --workspace @salon/backend run e2e:cucumber:dto-coverage",
    "e2e:cucumber:controller-coverage": "npm --workspace @salon/backend run e2e:cucumber:controller-coverage",
    "e2e:cucumber:coverage": "npm --workspace @salon/backend run e2e:cucumber:coverage",
    "e2e:coverage": "npm run e2e:cucumber:coverage",
    "lint": "eslint 'backend/src/**/*.{ts,tsx}' 'frontend/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'",
    "format": "prettier --write 'backend/src/**/*.{ts,tsx}' 'frontend/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'backend/src/**/*.{ts,tsx}' 'frontend/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "c8": "^10.1.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "//react-hoist": "Mixed React versions are intentional: web PWA uses React 18 and the Expo (SDK 57) mobile app uses React 19 + react-native 0.86. Metro pins each bundle to one React runtime; npm keeps the mobile copy nested so native and web do not share incompatible renderers.",
  "engines": {
    "node": ">=20.0.0"
  }
}
